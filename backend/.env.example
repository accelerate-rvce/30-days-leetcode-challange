PORT=4000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:3000
CHALLENGE_TIMEZONE=Asia/Kolkata
LEETCODE_GRAPHQL_URL=https://leetcode.com/graphql
# Safety controls for LeetCode's public GraphQL endpoint.
# Requests are globally spaced, and several users share one aliased query.
LEETCODE_MAX_CONCURRENCY=1
LEETCODE_MIN_REQUEST_INTERVAL_MS=1500
LEETCODE_USERS_PER_REQUEST=8
LEETCODE_DAILY_REQUEST_LIMIT=5000
LEETCODE_RATE_LIMIT_COOLDOWN_MS=900000
LEETCODE_FEED_LIMIT=20
LEETCODE_MAX_RETRIES=3
VERIFY_BATCH_SIZE=50
# Minimum gap between click-triggered verification cycles for one student.
VERIFICATION_KICK_COOLDOWN_MS=15000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
CRON_SECRET=
